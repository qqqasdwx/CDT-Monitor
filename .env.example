ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_REGION_ID=cn-hongkong
ECS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

CDT_TRAFFIC_THRESHOLD_GB=180
CDT_CHECK_INTERVAL_SECONDS=60
CDT_CONTROL_MODE=keep_running
ECS_STOPPED_MODE=StopCharging
ECS_FORCE_STOP=false
CDT_DRY_RUN=false
RUN_ONCE=false

# Optional. Paste the complete URL generated by one Uptime Kuma Push monitor.
UPTIME_KUMA_PUSH_URL=
LOG_LEVEL=INFO
