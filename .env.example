# Generate a long random value and keep the real .env file out of Git.
CDTM_ADMIN_PASSWORD=replace-with-a-long-random-password

# dry-run: no cloud requests; read-only: real queries; live: real queries and ECS mutations.
CDTM_ALIYUN_MODE=dry-run
CDTM_ALIYUN_CONNECT_TIMEOUT=5s
CDTM_ALIYUN_READ_TIMEOUT=10s

# The Compose port binds to localhost for a same-host reverse proxy.
CDTM_BIND_ADDRESS=127.0.0.1
CDTM_PUBLIC_PORT=8080

# Keep true behind HTTPS. The reverse proxy must overwrite forwarded client IP headers before enabling trust.
CDTM_SESSION_TTL=12h
CDTM_SECURE_SESSION_COOKIE=true
CDTM_LOGIN_MAX_FAILURES=5
CDTM_LOGIN_WINDOW=15m
CDTM_LOGIN_LOCKOUT=15m
CDTM_TRUST_PROXY_HEADERS=false

CDTM_SYNC_INTERVAL=5m
CDTM_KEEPALIVE_INTERVAL=10m
CDTM_LOG_LEVEL=info
